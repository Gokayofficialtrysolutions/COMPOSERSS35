   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class CircuitExecutor:\n",
    "    # BIT_ORDER removed as part of UI generalization. Results should be handled dynamically.\\n",
    "    # BIT_ORDER = ['000', '001', '010', '011', '100', '101', '110', '111']\\n",
    "    \n",
    "    def __init__(self, circuit):\n",
    "        \"\"\"\n",
    "        Helper Class to execute circuits on different backends.\n",
    "        \"\"\"\n",
    "        self.circuit = circuit\n",
    "        \n",
    "    # _fill_with_zero removed as BIT_ORDER is removed.\n",
    "\n",
    "    def _probabilities_backend(self, backend, num_shots=800, seed=None, result_options={}, transpile_before=False):\n",
    "        \"\"\"\n",
    "        Calculate probabilities on a given backend.\n",
    "        \"\"\"\n",
    "        # copy current circuit\n",
    "        mqc = self.circuit.copy()\n",
    "        num_qubits = mqc.num_qubits\n",
    "        # add measurement to all qubits if classical bits are present for them\n",
    "        # Assuming classical bits are added to match qubits that need measurement\n",
    "        # Or, if no classical bits, Qiskit might handle this; otherwise, this needs care.\n",
    "        # For simplicity, if classical bits exist, assume they match qubit count for measurement.\n",
    "        # A robust way is to ensure the circuit passed to CircuitExecutor has appropriate classical bits for intended measurements.\n",
    "        # Here, we'll try to measure all qubits to corresponding classical bits if available.\n",
    "        # This part is tricky without knowing how classical bits are managed upstream for generic circuits.\n",
    "        # The original code hardcoded `mqc.measure(range(3), range(3))`.\n",
    "        # We'll measure num_qubits to num_qubits if classical register is that large or unassigned.\n",
    "        if mqc.num_clbits >= num_qubits:\n",
    "            mqc.measure(range(num_qubits), range(num_qubits))\n",
    "        elif mqc.num_clbits > 0 : # measure only up to available classical bits\n",
    "             mqc.measure(range(mqc.num_clbits), range(mqc.num_clbits))\n",
    "        # If no classical bits, Qiskit's get_counts might still work based on simulator's behavior.\n",
    "        # transpile\n",
    "        mqc_transpiled = mqc if not transpile_before else transpile(mqc, backend)\n",
    "        # run job\n",
    "        job = backend.run(mqc_transpiled, shots=num_shots, seed=seed)\n",
    "        # get results\n",
    "        result = job.result(**result_options)\n",
    "        counts = result.get_counts(mqc_transpiled)\n",
    "        # divide by num_shots to get probabilities\n",
    "        # Sum of counts might not equal num_shots if there were mid-circuit measurements or resets not handled here.\n",
    "        # For basic final measurement scenarios, it should hold.\n",
    "        total_counts = np.sum([c for c in counts.values()])\n",
    "        if total_counts == 0: # Avoid division by zero if no counts (e.g. bad circuit or 0 shots)\n",
    "            return {}\n",
    "        for b in counts:\n",
    "            counts[b] = float(counts[b])/total_counts # Normalize by actual total_counts\n",
    "        return counts # No longer filling with zero for all possible bitstrings\n",
    "    \n",
    "    \n",
    "    def get_maximum_key(results):\n",
    "        \"\"\"\n",
    "        Get the key which has the highest maximum\n",
    "        \"\"\"\n",
    "        max_key = max(results, key=results.get)\n",
    "        return max_key\n",
    "    \n",
    "    \n",
    "    def probabilities_qasm(self, num_shots=800):\n",
    "        \"\"\"\n",
    "        Calculate probabilities on QASM Simulator\n",
    "        \"\"\"\n",
    "        return self._probabilities_backend(backend_qasm, num_shots=num_shots, seed=randint(0, 2500), transpile_before=True)\n",
    "    \n",
    "    \n",
    "    def probabilities_mock(self, num_shots=800):\n",
    "        \"\"\"\n",
    "        Calculate probabilities on Mock Device\n",
    "        \"\"\"\n",
    "        return self._probabilities_backend(backend_mock, num_shots=num_shots, transpile_before=True)\n",
    "    \n",
    "    \n",
    "    def probabilities_ibmq(self, num_shots=1, secs_timeout=30):\n",
    "        global data\\n",
    "        data.ibmq_message = \"\"\\n",
    "\\n",
    "        # Ensure backend_ibm is globally defined and potentially (re-)initialized if needed\\n",
    "        # This example assumes backend_ibm is set if the user configured an IBMQ_API_KEY and it was valid at startup\\n",
    "        if 'backend_ibm' not in globals() or backend_ibm is None:\\n",
    "            msg = \"IBMQ backend not configured/available. Using local noisy simulator for this action.\"\\n",
    "            if not os.getenv(\"IBMQ_API_KEY\"):\\n",
    "                msg = \"IBMQ_API_KEY not set. Using local noisy simulator.\"\\n",
    "            print(msg)\\n",
    "            data.ibmq_message = msg\\n",
    "            return self.probabilities_mock(num_shots=num_shots) # Fallback to mock\\n",
    "        try:\n",
    "            print(f\"Attempting to run on IBMQ backend: {backend_ibm.name()}\")\\n",
    "            res = self._probabilities_backend(backend_ibm, num_shots=num_shots, result_options={\"timeout\": secs_timeout, \"wait\": 2}, transpile_before=True)\n",
    "            data.ibmq_message = f\"Successfully executed on {backend_ibm.name()}.\"\\n",
    "            return res\n",
    "        except Exception as e:\n",
    "            msg = f\"IBMQ execution failed (Error: {str(e)[:100]}...). Using local noisy simulator.\"\\n",
    "            print(f\"Error running on IBM Q: {e}\")\\n",
    "            data.ibmq_message = msg\\n",
    "            return self.probabilities_mock(num_shots=num_shots) # Fallback to mock\\n",
    "    \n",
    "    \n",
    "    def probabilities_analytical(self):\n",
    "        \"\"\"\n",
    "        Calculate probabilities using the state vector (analytical solution).\\n",
    "        Returns a dictionary of {bitstring: probability}.\\n",
    "        \"\"\"\n",
    "        mqc = self.circuit.copy()\n",
    "        num_qubits = mqc.num_qubits\\n",
    "        if num_qubits == 0:\\n",
    "            return {}\\n",
    "        # run circuit on state vector\n",
    "        result = execute(mqc, backend_ideal).result()\n",
    "        # get state vector and calculate probabilities\n",
    "        state_vector = result.get_statevector(mqc, decimals=5) # Qiskit default decimals is 3 for statevector output string, but internal can be higher\n",
    "        probs = state_vector.probabilities() # This is an array of probabilities, indexed by integer representation of bitstring\n",
    "        \n",
    "        results = {}\\n",
    "        for i, prob_val in enumerate(probs):\n",
    "            if not np.isclose(prob_val, 0): # Only include non-zero probabilities\n",
    "                bitstring = format(i, f'0{num_qubits}b') # Format integer to binary string\n",
    "                results[bitstring] = prob_val\n",
    "        return results"
   ]
  },
