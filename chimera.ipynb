    "            )\n",
    "            explore_html = \"\".join([f\"<li>{item}</li>\" for item in explore_html])\n",
    "\n",
    "        data.circuit_info_html = f\"\"\"<h4>{title}</h4>\n",
    "                                     <p><strong>Concept:</strong> {description}</p>\n",
