  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "#### Composer View"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Introtext\n",
    "#view_composer_intro = appwidgets.ReactiveHtmlWidget(\"\"\"\n",
    "#    <p>{{${composer_init_circuit}['init_text']}}</p>\n",
    "#\"\"\", data_model=data)\n",
    "view_composer_intro = appwidgets.ReactiveHtmlWidget(\"\"\"\n",
    "    <p>Drag & Drop Quantum Gates onto the Qubits to build your circuit. <span data-rh-exec=\"load_welcome()\">Go back</span>.</p>\n",
    "    <div id=\"gate-toggle-button\" data-rh-exec-js='window.toggleGates()'></div>\n",
    "\"\"\")\n",
    "view_composer_intro.load_css(\"./css/view_composer_intro.css\")\n",
    "\n",
    "# Histogram\n",
    "# The hist_html will be dynamically generated by a Python function now\n",
    "def generate_dynamic_histogram_html(anal_probs, qasm_probs, mock_probs, num_qubits):\n",
    "    # Limit displayed bars for high qubit counts to prevent UI clutter\n",
    "    # For > 4 qubits, Qiskit's get_counts() might be more suitable directly in text form\n",
    "    # This is a simplified visual representation if we stick to bars for fewer qubits.\n",
    "    # For this example, we'll just iterate through analytical probabilities as the primary source of keys.\n",
    "    # A more robust solution would handle cases where keys might differ between prob dicts.\n",
    "
    "    # Determine the set of all possible bitstrings for the given number of qubits\n",
    "    # This is only practical for small num_qubits. For larger N, we'd only show measured states.\n",
    "    if num_qubits <= 4: # Threshold for displaying all bars\n",
    "        possible_outcomes = [format(i, f'0{num_qubits}b') for i in range(2**num_qubits)]\n",
    "    else:\n",
    "        # For larger circuits, just use the keys present in analytical results, or qasm if anal is empty\n",
    "        possible_outcomes = sorted(list(set(list(anal_probs.keys()) + list(qasm_probs.keys()))))\n",
    "        if len(possible_outcomes) > 16: # If still too many, truncate and add a message\n",
    "            # This part could be more sophisticated, e.g. show top N probabilities\n",
    "            # For now, just a placeholder message if it's too large after combining keys.\n",
    "            return \"<p><i>Histogram display truncated for large number of outcomes. Consider text-based counts.</i></p>\"\n",
    "\n",
    "    _hist_html = \"\"\n",
    "    for bitstring in possible_outcomes:\n",
    "        anal_val = anal_probs.get(bitstring, 0)\n",
    "        qasm_val = qasm_probs.get(bitstring, 0)\n",
    "        mock_val = mock_probs.get(bitstring, 0)\n",
    "        \n",
    "        # Use a generic color or cycle through a few if bitstring doesn't map to old DRINKS keys\n",
    "        # For simplicity, we'll use a default color here.\n",
    "        # A more advanced version could use a color hash based on the bitstring.\n",
    "        bar_class_key = bitstring # Or a hashed value for CSS consistency if needed\n",
    "\n",
    "        _hist_html += f\"\"\"\\n\
        <div class=\"histogram-entry\">\\n\
            <div class=\"histogram-text-container-pre\">\\n\
                <p><span class=\"histogram-text histogram-text-ideal histogram-text-{bar_class_key}\">{{int({anal_val}*1000)/10}}%</span></p>\\n\
            </div>\\n\
            <div class=\"histogram-bar-container\">\\n\
                <div class=\"histogram-bar-outer\">\\n\
                    <div data-rh-if=\"${{show_qasm_results}}\" style=\"height: {{{qasm_val}*100}}%\" class=\"histogram-bar histogram-bar-qasm histogram-bar-{bar_class_key}\"></div>\\n\
                    <div style=\"height: {{{anal_val}*100}}%\" class=\"histogram-bar histogram-bar-anal histogram-bar-{bar_class_key}\"></div>\\n\
                    <div data-rh-if=\"${{show_mock_results}}\" style=\"height: {{{mock_val}*100}}%\" class=\"histogram-bar histogram-bar-mock histogram-bar-{bar_class_key}\"></div>\\n\
                </div>\\n\
            </div>\\n\
            <div class=\"histogram-text-container-post\">\\n\
                <p>{bitstring}</p>\\n\
            </div>\\n\
        </div>\\n\
        \"\"\"\n",
    "    return _hist_html\n",
    "\n",
    "# This ReactiveHtmlWidget will now have its _rendered content updated by composer_update_handler\n",
    "view_composer_hist_content_widget = HTML() # Placeholder, content set by handler\n",
    "\n",
    "view_composer_button_bar = appwidgets.ReactiveHtmlWidget(\"\"\"\n",
    "    <div id=\"view-composer-hist-header\">\n",
    "        <h3>Measurement Probabilities</h3>\n",
    "    </div>\n",
    "    <div id=\"view-composer-button-bar\">\n",
    "        <button id=\"view-composer-show-theo-btn\" data-active=\"True\" class=\"btn btn-default\">Theoretical</button>\n",
    "        <button id=\"view-composer-show-qasm-btn\" data-active=\"${show_qasm_results}\" class=\"btn btn-default\" data-rh-exec=\"toggle_data_attr('show_qasm_results')\">Simulator (error free)</button>\n",
    "        <button id=\"view-composer-show-mock-btn\" data-active=\"${show_mock_results}\" class=\"btn btn-default mr-4\" data-rh-exec=\"toggle_data_attr('show_mock_results')\">Simulator (real quantum device)</button>\n",
    "        <button class=\"btn btn-default mr-4\" data-rh-exec=\"open_circuit_on_ibmq()\">Export to IBM Quantum Composer</button>\n",
    "        <button class=\"btn btn-default\" data-rh-exec=\"show_bloch_multivector()\">Show Bloch Spheres</button><!-- New Button -->\n",
    "    </div>\n",
    "    \n",
    "\"\"\", data_model=data)\n",
    "view_composer_button_bar.load_css(\"./css/view_composer_button_bar.css\")\n",
    "\n",
    "def show_bloch_multivector():\n",
    "    global data\n",
    "    from qiskit.visualization import plot_bloch_multivector\n",
    "    import io\n",
    "    import base64\n",
    "    import matplotlib.pyplot as plt # Import for plt.close()\n",
    "\n",
    "    data.bloch_sphere_html = \"\" # Clear previous plot\n",
    "    if data.current_statevector is not None and hasattr(data.current_statevector, 'num_qubits') and data.current_statevector.num_qubits > 0:\n",
    "        try:\n",
    "            fig = plot_bloch_multivector(data.current_statevector)\n",
    "            buf = io.BytesIO()\n",
    "            fig.savefig(buf, format='png', bbox_inches='tight')\n",
    "            buf.seek(0)\n",
    "            img_str = base64.b64encode(buf.read()).decode('utf-8')\n",
    "            data.bloch_sphere_html = f'<img src=\"data:image/png;base64,{img_str}\" alt=\"Bloch Spheres\" style=\"max-width:100%; height:auto;\"/>'\n",
    "            plt.close(fig)  # Close the plot to free up memory\n",
    "            buf.close()\n",
    "        except Exception as e:\n",
    "            print(f\"Error generating Bloch sphere plot: {e}\")\n",
    "            data.bloch_sphere_html = \"<p style='color:red;'>Error generating Bloch sphere plot. Ensure the circuit can produce a valid statevector.</p>\"\n",
    "    else:\n",
    "        data.bloch_sphere_html = \"<p>No statevector available or circuit has no qubits. Run analytical simulation first (e.g., by loading/changing the circuit).</p>\"\n"
    "\n",
    "# Container for the dynamically updated histogram content\n",
    "view_composer_hist_container_widget = appwidgets.ReactiveHtmlWidget(\"\"\"\n",
    "    <div id=\"view-composer-hist-container\">\n",
    "        <div id=\"view-composer-hist\">${dynamic_hist_html}</div>\n",
    "    </div>\n",
    "\"\"\", data_model=data)\n",
    "view_composer_hist_container_widget.load_css(\"./css/view_composer_hist.css\")\n",
    "\n",
    "# Add dynamic_hist_html trait to data model\n",
    "data.add_traits(dynamic_hist_html = Unicode(\"\").tag(sync=True))"
    "\n",
    "def _createOpenmojiImageCode(openmojiId: str, altText: str) -> str:\n",
    "    return f\"<img src='icons/openmoji-svg-color/{openmojiId}.svg' alt='{altText}' style='margin-left: auto; margin-right: auto; width: 50%''>\"\n",
    "\n",
    "drinkImgCode = _createOpenmojiImageCode('2615', 'Hot beverage')\n",
    "successImgCode = _createOpenmojiImageCode('1F44D', 'Thumbs up')\n",
    "failureImgCode = _createOpenmojiImageCode('1F635', 'Knocked-out face') # Retain for general error display if needed elsewhere, or remove if unused\n",
    "\n",
    "singleShotComposerCode = \"\"\"\n",
    "    <div id=\"view-composer-singleshot-container\">\n",
    "        <div id=\"view-composer-singleshot\">\n",
    "            <button class=\"btn btn-primary btn-block\" data-rh-exec=\"get_single_shot_result()\">Run Single Shot</button>\n",
    "            <br/>\n",
    "            <div data-rh-if='${single_shot_status}==1' class=\"width-100\">\n",
    "                <p style=\"width: 100%; text-align: center;\">Executing...</p>\n",
    "            </div>\n",
    "            <div id=\"view-composer-singleshot-result\" data-rh-if='${single_shot_status}==2' class=\"view-composer-order-text width-100\">\n",
    "                <p style=\"font-size: 1.5em; margin-bottom: 10px;\">Measured: <b>{{${single_shot_result}[\"bit\"]}}</b></p>\n",
    "                <!-- Removed 'Order Drink' and related status 3, 4 buttons/messages -->\n",
    "                <button class=\"btn btn-default btn-block\" data-rh-exec='data.single_shot_status=0'>Clear Result</button>\n",
    "            </div>\n",
    "            <br/> \n",
    "            <div class=\"width-100\" style=\"margin-top: 15px; padding: 5px; background-color: #f0f0f0; border-radius: 5px;\">\n",
    "                 <p style=\"font-size: 0.9em; color: #555; margin-bottom:0;\">Status/IBMQ Message: <span style=\"font-style: italic;\">${ibmq_message}</span></p>\n",
    "            </div>\n",
    "        </div>\n",
    "    </div>\n",
    "\"\"\"        \n",
    "# Single Shot\n",
    "view_composer_singleshot = appwidgets.ReactiveHtmlWidget(singleShotComposerCode, data_model=data)\n",
    "view_composer_singleshot.load_css(\"./css/view_composer_singleshot.css\")"
   ]
  },
