   "source": [
    "### Setup the composer"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "composer = CircuitComposer(circuit=qcreg[0]['circuit'])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# on changes on the composer, execute the circuit to get probabilities\n",
    "def composer_update_handler(change_event):\n",
    "    # there are multiple change events, only use on\n",
    "    if change_event['name'] != \"circuit\":\n",
    "        return\n",
    "    executor = CircuitExecutor(composer.circuit)\n",
    "    # set to 0 because calc requires some time and one sees wrong results for a second or so\n",
    "    data.histogram_mock = {key: 0 for key in CircuitExecutor.BIT_ORDER}\n",
    "    # get and save ideal result\n",
    "    # Also, get and store the statevector for potential Bloch sphere plot\n",
    "    mqc_ideal = composer.circuit.copy()\n",
    "    if mqc_ideal.num_qubits > 0:\n",
    "        try:\n",
    "            statevector_result = execute(mqc_ideal, backend_ideal).result()\n",
    "            data.current_statevector = statevector_result.get_statevector(mqc_ideal) # Store Statevector object\n",
    "            # Analytical probabilities can be derived from this statevector too\n",
    "            probs_from_sv = data.current_statevector.probabilities_dict(decimals=5)\n",
    "            data.histogram_anal = {format(int(k,2), f'0{mqc_ideal.num_qubits}b'): v for k,v in probs_from_sv.items()}            \n",
    "        except Exception as e_sv:\n",
    "            print(f\"Error getting statevector or its probabilities: {e_sv}\")\n",
    "            data.current_statevector = None\n",
    "            data.histogram_anal = executor.probabilities_analytical() # Fallback to original method if SV fails\n",
    "    else:\n",
    "        data.current_statevector = None\n",
    "        data.histogram_anal = {}\n",
    "\n",
    "    # get and save measurements\n",
    "    result_qasm = executor.probabilities_qasm()\n",
    "    data.histogram_qasm = result_qasm\n",
    "    # get and save qasm code\n",
    "    qasm = composer.circuit.qasm()\n",
    "    data.qasm = qasm\n",
    "\n",
    "    # Default to empty mock results if not shown, to avoid errors in generate_dynamic_histogram_html\n",
    "    result_mock = {} \n",
    "    if data.show_mock_results:\n",
    "        result_mock = executor.probabilities_mock()\n",
    "    data.histogram_mock = result_mock\n",
    "    \n",
    "    # Update dynamic histogram HTML\n",
    "    num_qubits_in_circuit = composer.circuit.num_qubits if composer.circuit else 0\n",
    "    data.dynamic_hist_html = generate_dynamic_histogram_html(\n",
    "        data.histogram_anal,\n",
    "        data.histogram_qasm,\n",
    "        data.histogram_mock,\n",
    "        num_qubits_in_circuit\n",
    "    )\n",
    "    \n",
    "composer.observe(composer_update_handler)\n",
    "\n",
    "# execute the function above also on changes on data.show_mock_results and data.show_qasm_results\n",
    "data.observe(lambda x: composer_update_handler({\"name\": \"circuit\"}), names=[\"show_mock_results\", \"show_qasm_results\"])"
   ]
  },
