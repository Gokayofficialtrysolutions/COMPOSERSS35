  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Assemble View"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "app.add_widget('welcome', view_welcome)\n",
    "app.add_widget('composer', view_composer)\n",
    "app.add_widget('error', view_fail)\n",
    "app.add_widget('success', view_success)\n",
    "\n",
    "# Define the new view for custom combinatorial circuit inputs\n",
    "style = {'description_width': 'initial'}\n",
    "layout_half = widgets.Layout(width='48%')\n",
    "layout_full = widgets.Layout(width='98%')\n",
    "\n",
    "data_combinatorial_type_dropdown = widgets.Dropdown(\n",
    "    options=[\n",
    "        ('Binomial Distribution', 'binomial'), \n",
    "        ('Combination (N choose k)', 'combination'), \n",
    "        ('Permutation (Custom List)', 'permutation')\n",
    "    ],\n",
    "    value=data.selected_combinatorial_type,\n",
    "    description='Circuit Type:',\n",
    "    style=style\n",
    ")\n",
    "link((data_combinatorial_type_dropdown, 'value'), (data, 'selected_combinatorial_type'))\n",
    "\n",
    "data_combinatorial_N_text = widgets.IntText(value=data.combinatorial_N, description='Number of Qubits (N):', style=style, layout=layout_half)\n",
    "link((data_combinatorial_N_text, 'value'), (data, 'combinatorial_N'))\n",
    "\n",
    "data_combinatorial_k_text = widgets.IntText(value=data.combinatorial_k, description='Qubits to Select (k) (for Combinations):', style=style, layout=layout_half)\n",
    "link((data_combinatorial_k_text, 'value'), (data, 'combinatorial_k'))\n",
    "\n",
    "data_combinatorial_p_text = widgets.FloatText(value=data.combinatorial_p, description='Success Probability (p) (for Binomial):', step=0.01, style=style, layout=layout_half)\n",
    "link((data_combinatorial_p_text, 'value'), (data, 'combinatorial_p'))\n",
    "\n",
    "data_combinatorial_pattern_textarea = widgets.Textarea(\n",
    "    value=data.combinatorial_pattern, \n",
    "    description='Permutation List (for N qubits, provide 2^N comma-separated integers, e.g., for N=2: \"0,2,1,3\"):', \n",
    "    style=style, \n",
    "    layout=layout_full\n",
    ")\n",
    "link((data_combinatorial_pattern_textarea, 'value'), (data, 'combinatorial_pattern'))\n",
    "\n",
    "generate_custom_circuit_button = widgets.Button(description=\"Generate & Load Circuit\", button_style='info', layout=widgets.Layout(width='200px'))\n",
    "generate_custom_circuit_button.on_click(lambda b: generate_and_load_custom_combinatorial_circuit())\n",
    "\n",
    "custom_circuit_message_html = appwidgets.ReactiveHtmlWidget(\"<p style='color:red;'>${ibmq_message}</p>\", data_model=data)\n",
    "\n",
    "view_combinatorics_input_content = VBox([\n",
    "    HTML(\"<h3>Create Custom Combinatorial Circuit</h3>\"),\n",
    "    data_combinatorial_type_dropdown,\n",
    "    HBox([data_combinatorial_N_text, data_combinatorial_k_text]),\n",
    "    data_combinatorial_p_text,\n",
    "    data_combinatorial_pattern_textarea,\n",
    "    generate_custom_circuit_button,\n",
    "    custom_circuit_message_html\n",
    "], layout=widgets.Layout(padding='10px'))\n",
    "\n",
    "view_combinatorics_input = VBox([header, view_combinatorics_input_content])\n",
    "app.add_widget('combinatorics_input_view', view_combinatorics_input)"
   ]
  },
