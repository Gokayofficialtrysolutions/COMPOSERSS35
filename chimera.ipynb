    "# assemble composer view\n",
    "circuit_info_display = appwidgets.ReactiveHtmlWidget(\"\"\"\\n\
    <div style='padding: 10px; margin-top:10px; border: 1px solid #e0e0e0; background-color: #f9f9f9;'>\\n\
        ${circuit_info_html}\\n\
    </div>\\n\
\"\"\", data_model=data)\n",
    "\n",
    "view_composer = VBox([\n",
    "    header,\n",
    "    VBox([\n",
    "        view_composer_intro,\n",
    "        composer,\n",
    "        HBox([\n",
    "            VBox([\n",
    "                view_composer_button_bar,\n",
    "                view_composer_hist_container_widget, # Changed from view_composer_hist\n",
    "                circuit_info_display,\n",
    "                appwidgets.ReactiveHtmlWidget(\"<div>${bloch_sphere_html}</div>\", data_model=data) # Added Bloch sphere display\n",
    "            ]).add_class(\"width-80\"),\n",
    "            view_composer_singleshot.add_class(\"width-20\")\n",
    "        ])\n",
    "    ]).add_class(\"app-view-content\")  \n",
    "])"
   ]
  },
